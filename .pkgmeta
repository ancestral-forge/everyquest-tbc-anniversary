package-as: EveryQuest-TBC-Anniversary

manual-changelog:
  filename: dist/release-notes.md
  markup-type: markdown

wowi-create-changelog: no

# The release workflow runs BigWigs in upload-only mode (-c -z). This entry lets
# the packager discover the primary TOC without replacing tools/package-release.sh.
move-folders:
  EveryQuest-TBC-Anniversary/EveryQuest: EveryQuest
